  "git": {
    "deploymentEnabled": {
      "pilot-ready-20260923": false
    }
  },
  "crons": [
    {
      "path": "/api/marketing-scheduler",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/legal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive, nosnippet"
        }
      ]
    }
  ]
