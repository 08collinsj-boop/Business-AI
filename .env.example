# Business AI Pilot environment template — placeholder values only.
# Never commit real secrets. Client-safe variables are marked explicitly.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe; prefer the current Supabase publishable key where available.
SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-safe fallback only if your project still uses it.
SUPABASE_ANON_KEY=

# Authentication feature gates
TENANCY_AUTH_ENABLED=true
FRONTEND_AUTH_ENABLED=true

# OpenAI — server only
OPENAI_API_KEY=

# Public enquiry protection — server only
RATE_LIMIT_SALT=
PUBLIC_ENQUIRY_RATE_LIMIT_MODE=database

# Stripe Pilot/Test — server only
BILLING_ENABLED=false
BILLING_APP_URL=https://business-ai-pilot.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Approved: GBP 19.99/month. Set only the matching Stripe TEST Price ID.
STRIPE_PRICE_ADDON_AI_MARKETING=

# Public owner-app origin used for safe Meta OAuth return redirects.
PUBLIC_APP_URL=https://business-ai-pilot.vercel.app

# Meta/Facebook/Instagram — server only unless noted otherwise.
# Configure these only after creating the Pilot Meta app and verifying the current Graph API version/scopes.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://business-ai-pilot.vercel.app/api/meta-callback
META_GRAPH_API_VERSION=
META_OAUTH_SCOPES=
# 32-byte random key encoded as 64 hex chars or base64. Keep server-only and backed up securely.
META_TOKEN_ENCRYPTION_KEY=
# Keep false until OAuth, Page selection and publish smoke tests have passed in Pilot.
META_PUBLISH_ENABLED=false

# Server-to-server scheduler authentication. Use a random value at least 32 chars.
MARKETING_SCHEDULER_SECRET=

# Voice foundation stays disabled until a provider-specific rollout is separately approved.
VOICE_RECEPTIONIST_ENABLED=false
